# Servidor
PORT=3001

# Instância Evolution API (única, configurada só pelo ambiente)
CAMARGO_INSTANCE_NAME=
CAMARGO_PHONE_NUMBER=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_URL=
# Alternativa a EVOLUTION_WEBHOOK_URL quando o domínio público é gerenciado fora do .env da instância:
PUBLIC_WEBHOOK_URL=

# OpenAI
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
AI_BASE_URL=
OPENAI_AUDIO_MODEL=gpt-4o-transcribe
OPENAI_VISION_MODEL=gpt-4.1-mini

# Simulação de digitação
TYPING_MIN_MS=2500
TYPING_MAX_MS=9000
TYPING_PER_CHAR_MS=140

# RAG
RAG_ENABLED=true
RAG_KNOWLEDGE_DIR=
RAG_TOP_K=4
RAG_MIN_SCORE=1.25

# PostgreSQL (use DATABASE_URL OU as variáveis POSTGRES_*)
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_SSL_CA=

# Webhook e endpoints de teste
WEBHOOK_SECRET=
TEST_API_KEY=

# Fila de conversa
MESSAGE_DEBOUNCE_MS=25000

# Pausa da IA (atendente assumiu ou transferência): expira sozinha depois de
# tantas horas sem nenhuma mensagem, pra não silenciar um cliente pra sempre.
PAUSE_EXPIRATION_HOURS=12

# Alertas para o time (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare R2 (mídias)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
MEDIA_MAX_BYTES=26214400

# Modo de teste (restringe a IA a um único número; deixe vazio em produção)
TEST_MODE_ALLOWED_NUMBER=

# Catálogo de produtos (GestãoClick) — Configurações > Integração via API
GESTAOCLICK_ACCESS_TOKEN=
GESTAOCLICK_SECRET_TOKEN=
